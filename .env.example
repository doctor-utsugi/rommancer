# Rommancer needs no .env to run. The installer (the web app's first page) asks for the database and the
# administrator; everything else is in Administration > Server. The secrets and the bundled MySQL's passwords are
# generated on the first start into data/secrets.
#
# Every variable below is optional. One that is set wins over the installer and the panel (the panel shows it
# and cannot change it): use them only to pin a value from the deployment.

# --- Deployment (compose) ---
# Rom folders mounted at /roms, web port, MySQL published on localhost (development)
# ROMS_DIR=./roms
# WEB_PORT=8080
# MYSQL_PORT=3317

# --- Database: a URL here skips the installer's first step ---
# DATABASE_URL=mysql://rommancer:password@127.0.0.1:3317/rommancer

# --- Server settings (Administration > Server) ---
# PUBLIC_URL=http://myserver:8080
# CORS_ORIGINS=
# EXTERNAL_SYNC_CRON="0 4 * * 0"
# FORCE_SYNC_MIN_MINUTES=10
# SEED_ON_START=true
# SEED_AUTO_EXPORT=true
# SCREENSCRAPER_DEV_ID=
# SCREENSCRAPER_DEV_PASSWORD=

# --- Local development only (npm run dev outside containers) ---
# API_PORT=3000
# Relative to backend/
# DATA_DIR=../data
# SEED_DIR=../seed
# Binaries, when they are not in PATH under these names
# CHDMAN_BIN=chdman
# SEVENZIP_BIN=7zz
