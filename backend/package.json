{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/main.ts",
    "start": "node dist/server.js",
    "build": "prisma generate && tsc -p tsconfig.json",
    "db:seed": "tsx --env-file=../.env src/seed/run.ts",
    "test": "tsx --env-file=../.env --test --test-concurrency=1 test/*.test.ts",
    "db:migrate": "dotenv -e ../.env -- prisma migrate deploy",
    "db:status": "dotenv -e ../.env -- prisma migrate status",
    "migration:new": "sh scripts/new-migration.sh"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "prisma": "^6.19.3",
    "ssh2-sftp-client": "^12.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/ssh2-sftp-client": "^9.0.6",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
