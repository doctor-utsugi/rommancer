generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum DatType {
  USER
  NOINTRO
  REDUMP
  FBNEO
  MAME
  HACKS
  OTHER
}

enum MatchStatus {
  MATCHED
  HACK
  UNVERIFIED
  UNKNOWN
}

enum MediaType {
  COVER
  BOX_BACK
  BOX_SIDE
  BOX_3D
  SUPPORT
  SCREENSHOT
  TITLE
  FLYER
  FANART
  MANUAL
  VIDEO
  MARQUEE
  WHEEL
}

enum Visibility {
  PRIVATE
  SHARED
  PUBLIC
}

enum ConnType {
  LOCAL
  SSH
  // The device runs event scripts (ES-DE, EmulationStation) and talks to the API
  AGENT
}

enum SaveKind {
  SAVE
  STATE
  // One save inside a memory card (a PS1 directory entry), synced on its own whatever card holds it
  ENTRY
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum HackType {
  HACK
  TRANSLATION
  IMPROVEMENT
  OTHER
}

model User {
  journeys           Journey[]
  journeyBlobs       JourneyBlob[]
  id                 Int       @id @default(autoincrement())
  username           String    @unique @db.VarChar(64)
  email              String    @unique @db.VarChar(191)
  passwordHash       String
  role               Role      @default(USER)
  locale             String    @default("en") @db.VarChar(8)
  // Encrypted external credentials (AES-256-GCM)
  ssUser             String?   @db.Text
  ssPassword         String?   @db.Text
  raUser             String?   @db.Text
  raApiKey           String?   @db.Text
  // RetroAchievements login for the consoles (some firmwares need the password itself) and the token RA gives for it
  raPassword         String?   @db.Text
  raToken            String?   @db.Text
  // The user's RetroAchievements profile (points, rank...) as last read with their Web API key, and when
  raProfile          Json?
  raProgressAt       DateTime?
  tgdbApiKey         String?   @db.Text
  // Permission list (see lib/permissions.ts). Admins have them all.
  permissions        Json?
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())

  lists         List[]
  listShares    ListShare[]
  wifiNetworks  WifiNetwork[]
  romFavorites  RomFavorite[]
  raProgress    RaUserProgress[]
  devices       Device[]
  deviceLinks   DeviceLink[]
  saves         Save[]
  memoryCards   MemoryCard[]
  jobs          Job[]
  refreshTokens RefreshToken[]
  invitations   Invitation[]     @relation("invitationCreator")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime
  // "Keep me signed in": lasts the server's session length; otherwise until the browser closes (a day at most)
  persistent Boolean  @default(true)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invitation {
  id          Int       @id @default(autoincrement())
  token       String    @unique @db.VarChar(64)
  role        Role      @default(USER)
  createdBy   Int
  usedById    Int?
  usedAt      DateTime?
  expiresAt   DateTime
  permissions Json?
  creator     User      @relation("invitationCreator", fields: [createdBy], references: [id], onDelete: Cascade)
}

model Setting {
  key   String @id @db.VarChar(64)
  value String @db.Text
}

model System {
  id           Int    @id @default(autoincrement())
  slug         String @unique @db.VarChar(32)
  name         String @db.VarChar(128)
  manufacturer String @db.VarChar(64)
  // Name used by No-Intro/Redump/libretro, e.g. "Nintendo - Nintendo Entertainment System"
  datName      String @unique @db.VarChar(191)
  datAliases   Json?
  extensions   Json
  // nes | snes | lynx | a7800 | fds | none
  headerType   String @default("none") @db.VarChar(16)
  // rom | disc | arcade
  mediaType    String @default("rom") @db.VarChar(16)
  raConsoleId  Int?
  ssSystemId   Int?
  sortOrder    Int    @default(0)

  games      Game[]
  datSources DatSource[]
  raGames    RaGame[]
  unknownFiles UnknownFile[]
}

model DatSource {
  id         Int       @id @default(autoincrement())
  type       DatType
  systemId   Int
  name       String    @db.VarChar(191)
  version    String?   @db.VarChar(64)
  fileSha1   String    @db.VarChar(40)
  // File name in DATA_DIR/dats or SEED_DIR/dats
  fileName   String?   @db.VarChar(255)
  // Highest priority: main source of names and data (official No-Intro over libretro copies)
  priority   Int       @default(0)
  importedAt DateTime  @default(now())
  romCount   Int       @default(0)
  system     System    @relation(fields: [systemId], references: [id], onDelete: Cascade)
  roms       Rom[]
  hacks      RomHack[]

  @@unique([systemId, type, name])
}

model Game {
  id              Int        @id @default(autoincrement())
  systemId        Int
  title           String     @db.VarChar(255)
  titleNormalized String     @db.VarChar(255)
  releaseYear     Int?
  developer       String?    @db.VarChar(128)
  publisher       String?    @db.VarChar(128)
  genre           String?    @db.VarChar(128)
  players         String?    @db.VarChar(32)
  description     String?    @db.Text
  ssGameId        Int?
  tgdbGameId      Int?
  // Franchise according to libretro (used when Wikidata gives none)
  franchiseName   String?    @db.VarChar(255)
  scrapedAt       DateTime?
  // Provenance of each field: { field: source }. Priority manual > screenscraper > thegamesdb > libretro
  metaSources     Json?
  // Grouping: cross-platform work, Wikidata item and confidence of the regional grouping
  workId          Int?
  wikidataId      String?    @db.VarChar(16)
  groupConfidence String     @default("high") @db.VarChar(8)
  createdById     Int?
  // The game an uploaded game was made from (a hack or randomizer stored as a game of its own), found by its content
  baseGameId      Int?
  system          System     @relation(fields: [systemId], references: [id], onDelete: Cascade)
  work            Work?      @relation(fields: [workId], references: [id], onDelete: SetNull)
  baseGame        Game?      @relation("GameBase", fields: [baseGameId], references: [id], onDelete: SetNull)
  derivedGames    Game[]     @relation("GameBase")
  roms            Rom[]
  hacks           RomHack[]
  media           Media[]
  listItems       ListItem[]
  unknownFiles    UnknownFile[]
  saves           Save[]

  @@index([systemId, titleNormalized])
  @@index([title])
  @@index([workId])
  @@index([baseGameId])
}

model Rom {
  id                Int           @id @default(autoincrement())
  gameId            Int
  datSourceId       Int
  name              String        @db.VarChar(255)
  regions           Json
  languages         Json
  revision          String?       @db.VarChar(32)
  flags             Json
  isBios            Boolean       @default(false)
  // RA hash precomputed from the DAT when the algorithm allows it
  raHash            String?       @db.Char(32)
  raGameId          Int?
  serial            String?       @db.VarChar(64)
  // Original title (e.g. Japanese) according to Retool
  localTitle        String?       @db.VarChar(255)
  // DAT description (for arcade it is the title; the name is the set's)
  description       String?       @db.VarChar(255)
  // Parent according to No-Intro Parent/Clone
  parentName        String?       @db.VarChar(255)
  // The source no longer contains it; kept (permanent data)
  removedFromSource Boolean       @default(false)
  checkedAt         DateTime?
  createdById       Int?
  game              Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  datSource         DatSource     @relation(fields: [datSourceId], references: [id], onDelete: Cascade)
  parts             RomPart[]
  favorites         RomFavorite[]
  listItems         ListItem[]
  media             Media[]
  saves             Save[]
  baseOfHacks       RomHack[]

  @@unique([datSourceId, name])
  @@index([raHash])
  @@index([gameId])
  @@index([name])
}

model RomPart {
  id             Int       @id @default(autoincrement())
  romId          Int
  name           String    @db.VarChar(255)
  size           BigInt
  crc32          String?   @db.Char(8)
  md5            String?   @db.Char(32)
  sha1           String?   @db.Char(40)
  headerlessSize BigInt?
  headerlessCrc  String?   @db.Char(8)
  headerlessMd5  String?   @db.Char(32)
  headerlessSha1 String?   @db.Char(40)
  rom            Rom       @relation(fields: [romId], references: [id], onDelete: Cascade)
  files          RomFile[]

  @@index([sha1])
  @@index([md5])
  @@index([crc32, size])
  @@index([headerlessSha1])
  @@index([headerlessMd5])
  @@index([romId])
}

model RomHack {
  id                Int        @id @default(autoincrement())
  gameId            Int
  baseRomId         Int?
  datSourceId       Int?
  type              HackType   @default(HACK)
  title             String     @db.VarChar(255)
  // Short name of the hack ("Spec II"); version is the hack's, not the game's
  hackName          String?    @db.VarChar(255)
  author            String?    @db.VarChar(255)
  version           String?    @db.VarChar(64)
  language          String?    @db.VarChar(32)
  description       String?    @db.Text
  sourceUrl         String?    @db.VarChar(512)
  size              BigInt?
  crc32             String?    @db.Char(8)
  md5               String?    @db.Char(32)
  sha1              String?    @db.Char(40)
  // Hash of the content without header (NES, SNES...), to recognise the file with or without it
  headerlessSha1    String?    @db.Char(40)
  // How it was linked to its base rom: dat | patch | content | header | manual | title
  baseEvidence      String?    @db.VarChar(16)
  removedFromSource Boolean    @default(false)
  createdAt         DateTime   @default(now())
  game              Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  baseRom           Rom?       @relation(fields: [baseRomId], references: [id], onDelete: SetNull)
  patches           RomPatch[]
  datSource         DatSource? @relation(fields: [datSourceId], references: [id], onDelete: Cascade)
  files             RomFile[]
  listItems         ListItem[]

  @@index([sha1])
  @@index([md5])
  @@index([headerlessSha1])
}

model RomPath {
  id              Int       @id @default(autoincrement())
  label           String    @db.VarChar(128)
  path            String    @unique @db.VarChar(700)
  // If set, everything scanned is assumed to be of that system; otherwise it is inferred from folder/extension
  systemId        Int?
  // Destination for new roms (uploads, patches): systems (slugs) it receives and folder scheme
  targetSystems   Json?
  isDefaultTarget Boolean   @default(false)
  // system | flat | <firmware slug>
  targetScheme    String    @default("system") @db.VarChar(32)
  readOnly        Boolean   @default(false)
  lastScanAt      DateTime?
  // Identity of the folder: a marker file (.rommancer-id) holds this id in folders Rommancer may write to;
  // wasMount records that the folder was a mount point, so an unmounted disk is noticed
  volumeId        String?   @db.Char(36)
  wasMount        Boolean   @default(false)
  // Not reachable (disk unplugged, not mounted, emptied): its index is kept untouched and nothing is written
  offlineAt       DateTime?
  offlineReason   String?   @db.VarChar(64)
  // Last scan held back something (e.g. it would have removed most of the folder)
  scanWarning     String?   @db.VarChar(255)
  // Destinations: free space kept on the disk, and order among destinations of the same system
  reservePercent  Int       @default(5)
  priority        Int       @default(0)
  // Folder name -> system slug, for folders whose name says nothing ("varios", "SFC")
  folderSystems   Json?
  files           RomFile[]
}

/**
 * A file that disappeared: its hashes, kept for a while so the same file found elsewhere is not hashed again
 */
model RomFileGone {
  id        Int      @id @default(autoincrement())
  quickHash String   @db.Char(40)
  fileSize  BigInt
  data      Json
  goneAt    DateTime @default(now())

  @@index([quickHash, fileSize])
  @@index([goneAt])
}

model RomFile {
  id             Int         @id @default(autoincrement())
  romPathId      Int
  // sha1(relativePath + "\0" + archiveEntry) for a unique index
  pathKey        String      @db.Char(40)
  relativePath   String      @db.VarChar(1024)
  archiveEntry   String?     @db.VarChar(512)
  size           BigInt
  // Size and date of the file on disk (change detection; size is the content's)
  fileSize       BigInt      @default(0)
  // sha1(size + first MiB + last MiB): reuses hashes of moved or renamed files
  quickHash      String?     @db.Char(40)
  mtimeMs        BigInt
  crc32          String      @db.Char(8)
  md5            String?     @db.Char(32)
  sha1           String?     @db.Char(40)
  headerlessCrc  String?     @db.Char(8)
  headerlessMd5  String?     @db.Char(32)
  headerlessSha1 String?     @db.Char(40)
  raHash         String?     @db.Char(32)
  systemId       Int?
  status         MatchStatus @default(UNKNOWN)
  romPartId      Int?
  romHackId      Int?
  uploadedById   Int?
  // Container format (rvz, wbfs, cso...) and disc id if applicable
  container      String?     @db.VarChar(8)
  discId         String?     @db.VarChar(16)
  // Already evaluated as a possible romhack by content
  hackCheckedAt  DateTime?
  scannedAt      DateTime    @default(now())
  romPath        RomPath     @relation(fields: [romPathId], references: [id], onDelete: Cascade)
  romPart        RomPart?    @relation(fields: [romPartId], references: [id], onDelete: SetNull)
  romHack        RomHack?    @relation(fields: [romHackId], references: [id], onDelete: SetNull)

  @@unique([romPathId, pathKey])
  @@index([sha1])
  @@index([headerlessSha1])
  @@index([quickHash])
  @@index([romPartId])
  @@index([status])
}

model Media {
  id        Int       @id @default(autoincrement())
  gameId    Int?
  romId     Int?
  type      MediaType
  source    String    @db.VarChar(32)
  path      String    @db.VarChar(512)
  region    String?   @db.VarChar(16)
  language  String?   @db.VarChar(16)
  size      Int?
  createdAt DateTime  @default(now())
  game      Game?     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  rom       Rom?      @relation(fields: [romId], references: [id], onDelete: Cascade)

  @@index([gameId, type])
}

model List {
  id              Int          @id @default(autoincrement())
  ownerId         Int
  name            String       @db.VarChar(191)
  description     String?      @db.Text
  visibility      Visibility   @default(PRIVATE)
  isCollaborative Boolean      @default(false)
  parentListId    Int?
  derivedFilter   Json?
  // null: a normal list | favorites: the user's favourite roms (one per user, kept in step with RomFavorite)
  kind            String?      @db.VarChar(16)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  owner           User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parent          List?        @relation("derived", fields: [parentListId], references: [id], onDelete: SetNull)
  children        List[]       @relation("derived")
  items           ListItem[]
  devices         DeviceList[]
  shares          ListShare[]
  picksOf         Device?      @relation("devicePicks")
}

model ListItem {
  id       Int      @id @default(autoincrement())
  listId   Int
  gameId   Int?
  romId    Int?
  hackId   Int?
  workId   Int?
  unknownId Int?
  // Unique key: r<id> | h<id> | u<id> (game and work items are turned into one of their roms)
  itemKey  String   @db.VarChar(24)
  position Int      @default(0)
  note     String?  @db.VarChar(512)
  list     List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  game     Game?    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  rom      Rom?     @relation(fields: [romId], references: [id], onDelete: Cascade)
  hack     RomHack? @relation(fields: [hackId], references: [id], onDelete: Cascade)
  work     Work?    @relation(fields: [workId], references: [id], onDelete: Cascade)
  unknown  UnknownFile? @relation(fields: [unknownId], references: [id], onDelete: Cascade)

  @@unique([listId, itemKey])
}

// A file no database identified (a hack or translation nobody registered, a homebrew, a dump of its own), kept so
// lists can hold it: told apart by its content, or by its system, size and name when it was never hashed
model UnknownFile {
  id             Int        @id @default(autoincrement())
  fileKey        String     @unique @db.Char(40)
  sha1           String?    @db.Char(40)
  headerlessSha1 String?    @db.Char(40)
  name           String     @db.VarChar(255)
  size           BigInt     @default(0)
  systemId       Int?
  // The folder the device kept it in, where it goes on other devices when it is of no system
  folder         String?    @db.VarChar(255)
  // The game it is a hack or translation of, when that is known
  baseGameId     Int?
  createdAt      DateTime   @default(now())
  system         System?    @relation(fields: [systemId], references: [id], onDelete: SetNull)
  baseGame       Game?      @relation(fields: [baseGameId], references: [id], onDelete: SetNull)
  listItems      ListItem[]

  @@index([sha1])
}

model ListShare {
  listId  Int
  userId  Int
  canEdit Boolean @default(false)
  list    List    @relation(fields: [listId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([listId, userId])
}

model Console {
  id           Int      @id @default(autoincrement())
  name         String   @unique @db.VarChar(128)
  manufacturer String   @db.VarChar(64)
  formFactor   String   @default("handheld") @db.VarChar(32)
  // WiFi bands of the model: none | 2.4 | dual; null = not known
  wifiBands    String?  @db.VarChar(8)
  devices      Device[]
}

model Firmware {
  id          Int      @id @default(autoincrement())
  slug        String   @unique @db.VarChar(32)
  name        String   @db.VarChar(128)
  // Paths relative to the device root
  romsRoot    String   @db.VarChar(255)
  savesRoot   String   @db.VarChar(255)
  statesRoot  String   @db.VarChar(255)
  biosRoot    String   @db.VarChar(255)
  // { systemSlug: { folder, emulator } }
  systemMap   Json
  // flat: savesRoot/<rom>.srm | system: savesRoot/<folder>/ | core: savesRoot/<core>/ | rom: next to the rom
  savesLayout String   @default("flat") @db.VarChar(16)
  devices     Device[]
}

model Device {
  journeyBindings    JourneyBinding[]
  journeyRevisions   JourneyRevision[]
  id              Int                   @id @default(autoincrement())
  userId          Int
  name            String                @db.VarChar(128)
  consoleId       Int
  firmwareId      Int
  connType        ConnType
  // Device root: local path (mounted SD) or remote path over SSH
  rootPath        String                @db.VarChar(512)
  sshHost         String?               @db.VarChar(255)
  sshPort         Int?                  @default(22)
  sshUser         String?               @db.VarChar(64)
  // Encrypted
  sshPassword     String?               @db.Text
  sshKey          String?               @db.Text
  // Overrides Firmware fields: { romsRoot, savesRoot, statesRoot, systemMap }
  overrides       Json?
  syncSaves       Boolean               @default(false)
  lastSyncAt      DateTime?
  // Token for the device's scripts (sha256); null = no token
  tokenHash       String?               @unique @db.Char(64)
  tokenCreatedAt  DateTime?
  lastSeenAt      DateTime?
  // Tail of the client's log and its version, sent after each sync (remote troubleshooting)
  lastLog         String?               @db.Text
  clientVersion   String?               @db.VarChar(32)
  // When the server first heard from the client in its current version (its install or update)
  clientUpdatedAt DateTime?
  romLists        DeviceList[]
  // The device lets the server fetch roms from it (client setting, reported on every sync)
  allowPull       Boolean               @default(true)
  // Set from the web app; the client syncs at its next poll and clears it
  wantSyncAt      DateTime?
  inventoryAt     DateTime?
  /// sha1 of the last inventory the device sent: an unchanged one is not stored again
  inventoryHash   String?   @db.VarChar(40)
  /// Whether the device sets its clock from the internet (Onion's Tweaks), as it reports; null: unknown or not its call
  clockSync       Boolean?
  /// The user asked from the web app to turn that on: the device does it at its next sync
  clockSyncWant   Boolean   @default(false)
  // Where the client script lives on the device, so the server can run it over SSH when the device is quiet
  clientPath      String?               @db.VarChar(512)
  // The SSH address was typed in the web app: the one the console reports about itself does not replace it
  sshManual       Boolean               @default(false)
  // Last time the server reached the device over SSH, and why it failed if it did
  sshAt           DateTime?
  sshError        String?               @db.VarChar(255)
  inventory       DeviceRom[]
  pulls           DevicePull[]
  probes          DeviceProbe[]
  // Extra keys: SD cards of this device synced from a computer (the console keeps its own tokenHash)
  cardTokens      DeviceToken[]
  // Linked from the desktop companion: only known when its card is connected to a computer
  offline         Boolean               @default(false)
  // Which systems and games of its lists are copied: { newAuto, excluded, known, excludedGames } (devices/sink.ts)
  systemFilter    Json?
  // Free space kept on the device when copying list roms, its space as last reported by the client,
  // and what did not fit at the last copy ({ at, files, bytes })
  reservePercent  Int                   @default(5)
  spaceFree       BigInt?
  spaceTotal      BigInt?
  spaceAt         DateTime?
  spaceShortfall  Json?
  // WiFi bands the device reported (or the user set: wifiBandsManual); null = the console model's
  wifiBands       String?               @db.VarChar(8)
  wifiBandsManual Boolean               @default(false)
  // RetroArch cores installed and their versions ({ "mGBA": "0.10.3" }), as the client last reported them
  coreVersions    Json?
  // The core each system saves with on this device ({ "snes": "Supafaust" }), learnt from where its emulator writes
  systemCores     Json?
  // The core each game was last seen saving with on this device ({ "<rom name>": "Snes9x" })
  romCores        Json?
  // Games a frontend on this device launches (LaunchBox): each rom's system and emulator setup, and where each
  // setup keeps saves and states. See LauncherInfo in saves/agent.ts
  launcher        Json?
  // The user's settings (RetroAchievements, WiFi) are kept applied on it; what was last applied and when
  keepSettings    Boolean               @default(true)
  settingsHash    String?               @db.Char(40)
  settingsAt      DateTime?
  settingsError   String?               @db.VarChar(512)
  configVersions  DeviceConfigVersion[]
  configOps       DeviceConfigOp[]
  // Roms in no list assigned to the device are deleted from it (devices/prune.ts). The console owns the
  // setting: pruneRemote = changed from the web app and not yet answered on the console
  pruneRoms       Boolean               @default(false)
  pruneRemote     Boolean               @default(false)
  // A deletion of more than half of the device's roms waits: how many it would delete, and how many the user allowed
  pruneHeld       Int?
  pruneAllow      Int?
  // Frontends show each list given to the device as a collection (ES-DE, EmulationStation)
  listCollections Boolean               @default(true)
  // The list of games picked for this device (browsed on the console or sent from the web app): devices/picks.ts
  picksListId     Int?                  @unique
  picksList       List?                 @relation("devicePicks", fields: [picksListId], references: [id], onDelete: SetNull)
  createdAt       DateTime              @default(now())
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  console         Console               @relation(fields: [consoleId], references: [id])
  firmware        Firmware              @relation(fields: [firmwareId], references: [id])
  saveVersions    SaveVersion[]
  saveStates      SaveDeviceState[]
  conflicts       SaveConflict[]
  deviceCards     DeviceCard[]
}

model RomIdentity {
  id          String   @id @db.Char(40)
  platform    String   @db.VarChar(32)
  digest      String   @db.Char(40)
  title       String   @db.VarChar(255)
  journeys    Journey[]
  bindings    JourneyBinding[]

  @@unique([platform, digest])
}

model Journey {
  id          String   @id @db.Char(36)
  userId      Int
  identityId  String   @db.Char(40)
  name        String   @db.VarChar(80)
  head        Int      @default(0)
  metadata    Int      @default(0)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  identity    RomIdentity @relation(fields: [identityId], references: [id])
  revisions   JourneyRevision[]

  @@index([userId, identityId])
}

model JourneyRevision {
  id          String   @id @db.Char(36)
  journeyId   String   @db.Char(36)
  number      Int
  base        Int
  manifest    Json
  conflict    Boolean  @default(false)
  sourceDeviceId Int?
  sourceDevice Device? @relation(fields: [sourceDeviceId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  journey     Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId, number])
}

model JourneyBlob {
  userId      Int
  sha1        String   @db.Char(40)
  size        Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, sha1])
}

model JourneyBinding {
  id          String   @id @db.Char(36)
  deviceId    Int
  identityId  String   @db.Char(40)
  romPath     String   @db.VarChar(1024)
  layout      Json
  journeyId   String   @db.Char(36)
  generation  Int      @default(0)
  operation   String   @db.Char(36)
  updatedAt   DateTime @updatedAt
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  identity    RomIdentity @relation(fields: [identityId], references: [id])
  commands    JourneyCommand[]

  @@unique([deviceId, identityId])
}

model JourneyCommand {
  id          String   @id @db.Char(36)
  bindingId   String   @db.Char(36)
  journeyId   String   @db.Char(36)
  generation  Int
  status      String   @default("pending") @db.VarChar(32)
  error       String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  binding     JourneyBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@index([bindingId, status])
}

model Emulator {
  id         Int     @id @default(autoincrement())
  slug       String  @unique @db.VarChar(64)
  name       String  @db.VarChar(128)
  // RetroArch core if any
  core       String? @db.VarChar(64)
  // Logical save format: raw | ps1card
  saveFormat String  @default("raw") @db.VarChar(16)
  saveExt    String  @db.VarChar(16)
  stateExt   String? @db.VarChar(16)
  saves      Save[]
  cards      DeviceCard[]
}

model Save {
  id               Int               @id @default(autoincrement())
  userId           Int
  gameId           Int?
  romId            Int?
  emulatorId       Int
  kind             SaveKind
  slot             Int               @default(0)
  // Base file name (no extension) as found; ENTRY: the entry's name in the card's directory
  baseName         String            @db.VarChar(255)
  // ENTRY: the user's memory card it belongs to (slot holds the same id, so the key above stays unique per card)
  cardId           Int?
  // ENTRY: the title the game wrote for the memory card screen
  label            String?           @db.VarChar(128)
  // A whole PS1 card kept as one save before cards were read entry by entry: its entries were taken out
  supersededAt     DateTime?
  currentVersionId Int?
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  game             Game?             @relation(fields: [gameId], references: [id], onDelete: SetNull)
  rom              Rom?              @relation(fields: [romId], references: [id], onDelete: SetNull)
  emulator         Emulator          @relation(fields: [emulatorId], references: [id])
  card             MemoryCard?       @relation(fields: [cardId], references: [id], onDelete: Cascade)
  versions         SaveVersion[]
  deviceStates     SaveDeviceState[]
  conflicts        SaveConflict[]
  cardBases        CardEntryBase[]

  @@unique([userId, emulatorId, kind, slot, baseName])
  @@unique([cardId, baseName])
}

// A user's memory card: a set of entries (saves) of one card family that consoles mount
model MemoryCard {
  id          Int          @id @default(autoincrement())
  userId      Int
  // ps1
  family      String       @db.VarChar(16)
  name        String       @db.VarChar(64)
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  saves       Save[]
  deviceCards DeviceCard[]

  @@unique([userId, family, name])
}

// A memory card file on a device: the server reads its entries and writes entries into it, never replacing it whole
model DeviceCard {
  id         Int             @id @default(autoincrement())
  deviceId   Int
  // Relative to the device's root
  path       String          @db.VarChar(512)
  emulatorId Int
  // A card every game shares (pcsx-card2.mcd); otherwise the emulator keeps it for one game (RetroArch's <rom>.srm)
  shared     Boolean         @default(false)
  // The game of a per-game card, when known
  gameId     Int?
  // The user's memory card mounted in it
  cardId     Int
  // The card as last read from the device
  lastSha1   String?         @db.Char(40)
  // The card last sent to the device and the entry versions in it: they count as synced only once the device is seen with it
  offerSha1  String?         @db.Char(40)
  offer      Json?
  freeBlocks Int?
  // Why entries could not be written (card full, damaged card)
  warning    String?         @db.VarChar(512)
  updatedAt  DateTime        @updatedAt
  device     Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  card       MemoryCard      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  emulator   Emulator        @relation(fields: [emulatorId], references: [id])
  bases      CardEntryBase[]
  snapshots  CardSnapshot[]

  @@unique([deviceId, path])
}

// Per card file and entry: the version last synced and the entry's sha1 there
model CardEntryBase {
  deviceCardId Int
  saveId       Int
  versionId    Int?
  // null: the device took the entry out of this card; it goes back only when the save changes
  entrySha1    String?    @db.Char(40)
  syncedAt     DateTime   @default(now())
  deviceCard   DeviceCard @relation(fields: [deviceCardId], references: [id], onDelete: Cascade)
  save         Save       @relation(fields: [saveId], references: [id], onDelete: Cascade)

  @@id([deviceCardId, saveId])
}

// Whole images of a device's card, as read (seen) and as sent (sent), to put a card back as it was
model CardSnapshot {
  id           Int        @id @default(autoincrement())
  deviceCardId Int
  sha1         String     @db.Char(40)
  path         String     @db.VarChar(512)
  size         Int
  // seen | sent
  kind         String     @db.VarChar(8)
  createdAt    DateTime   @default(now())
  deviceCard   DeviceCard @relation(fields: [deviceCardId], references: [id], onDelete: Cascade)

  @@index([deviceCardId])
}

model SaveVersion {
  id             Int      @id @default(autoincrement())
  saveId         Int
  path           String   @db.VarChar(512)
  size           Int
  sha1           String   @db.Char(40)
  // mtime of the source file
  fileMtime      DateTime
  sourceDeviceId Int?
  note           String?  @db.VarChar(255)
  // Savestates: the core's version on the device that made it (states may not load in another one)
  coreVersion    String?  @db.VarChar(64)
  // The emulator's screenshot of a savestate (RetroArch .png, NextUI .bmp), relative to the saves folder
  thumbPath      String?  @db.VarChar(512)
  // Shared with every user of the server, who can see it in the game and take a copy
  sharedAt       DateTime?
  shareNote      String?  @db.VarChar(255)
  createdAt      DateTime @default(now())
  save           Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  sourceDevice   Device?  @relation(fields: [sourceDeviceId], references: [id], onDelete: SetNull)

  @@index([saveId])
  @@index([sharedAt])
}

model RaGame {
  id              Int      @id
  systemId        Int
  title           String   @db.VarChar(255)
  numAchievements Int      @default(0)
  imageIcon       String?  @db.VarChar(255)
  fetchedAt       DateTime @default(now())
  system          System   @relation(fields: [systemId], references: [id], onDelete: Cascade)
  hashes          RaHash[]
}

model RaHash {
  hash     String @db.Char(32)
  raGameId Int
  raGame   RaGame @relation(fields: [raGameId], references: [id], onDelete: Cascade)

  @@id([hash, raGameId])
  @@index([raGameId])
}

model Job {
  id         Int       @id @default(autoincrement())
  userId     Int?
  type       String    @db.VarChar(32)
  status     JobStatus @default(PENDING)
  params     Json
  total      Int       @default(0)
  processed  Int       @default(0)
  message    String?   @db.VarChar(512)
  log        String?   @db.MediumText
  result     Json?
  // Do not run before this date (quota resumptions)
  runAfter   DateTime?
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
}

model Work {
  id          Int        @id @default(autoincrement())
  title       String     @db.VarChar(255)
  wikidataId  String?    @unique @db.VarChar(16)
  franchiseId Int?
  releaseYear Int?
  franchise   Franchise? @relation(fields: [franchiseId], references: [id], onDelete: SetNull)
  games       Game[]
  listItems   ListItem[]
}

model Franchise {
  id         Int     @id @default(autoincrement())
  name       String  @db.VarChar(255)
  wikidataId String? @unique @db.VarChar(16)
  works      Work[]
}

// Grouping evidence: roms (or games) with the same key belong to the same group
model GroupingEvidence {
  id         Int      @id @default(autoincrement())
  // rom-game: groups roms into games; game-work: links games to Wikidata items
  kind       String   @db.VarChar(12)
  romId      Int?
  gameId     Int?
  systemId   Int
  key        String   @db.VarChar(255)
  // manual | nointro-pc | retool | ra | screenscraper | wikidata | title
  source     String   @db.VarChar(16)
  confidence Int
  createdAt  DateTime @default(now())

  @@unique([kind, romId, gameId, source, key])
  @@index([kind, systemId, key])
  @@index([romId])
  @@index([gameId])
}

// Manual decisions the resolver honours
model GroupingRule {
  id         Int      @id @default(autoincrement())
  kind       String   @db.VarChar(12)
  // same | different
  rule       String   @db.VarChar(10)
  aRomId     Int?
  bRomId     Int?
  aGameId    Int?
  bGameId    Int?
  wikidataId String?  @db.VarChar(16)
  userId     Int?
  createdAt  DateTime @default(now())
}

model ReviewItem {
  id         Int       @id @default(autoincrement())
  // title-group | conflict | wikidata
  kind       String    @db.VarChar(16)
  systemId   Int?
  gameId     Int?
  key        String    @db.VarChar(191)
  payload    Json
  status     String    @default("open") @db.VarChar(10)
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  resolvedBy Int?

  @@unique([kind, key])
  @@index([status, kind])
}

// Local subset of Wikidata: video games of the supported platforms
model WikidataItem {
  qid          String    @id @db.VarChar(16)
  label        String    @db.VarChar(255)
  names        Json
  platforms    Json
  year         Int?
  seriesQid    String?   @db.VarChar(16)
  franchiseQid String?   @db.VarChar(16)
  raIds        Json?
  ssIds        Json?
  modified     DateTime?
  fetchedAt    DateTime  @default(now())
}

model WikidataLabel {
  qid   String @id @db.VarChar(16)
  label String @db.VarChar(255)
}

model RomPatch {
  id          Int      @id @default(autoincrement())
  hackId      Int
  format      String   @db.VarChar(4)
  // Path relative to DATA_DIR/patches
  path        String   @db.VarChar(255)
  size        Int
  sha1        String   @unique @db.Char(40)
  baseRomId   Int?
  baseCrc32   String?  @db.Char(8)
  targetCrc32 String?  @db.Char(8)
  sourceUrl   String?  @db.VarChar(512)
  createdById Int?
  createdAt   DateTime @default(now())
  hack        RomHack  @relation(fields: [hackId], references: [id], onDelete: Cascade)
}

// Known state of each external source (ETag, version, dates)
model SourceState {
  key          String    @id @db.VarChar(191)
  etag         String?   @db.VarChar(255)
  lastModified String?   @db.VarChar(64)
  version      String?   @db.VarChar(64)
  checkedAt    DateTime?
  changedAt    DateTime?
}

// "Not found" in an external service, so the lookup is not repeated for months
model ScrapeMiss {
  id     Int      @id @default(autoincrement())
  gameId Int
  source String   @db.VarChar(16)
  at     DateTime @default(now())

  @@unique([gameId, source])
}

// Daily quota per ScreenScraper/TheGamesDB credential
model ScrapeQuota {
  key         String    @id @db.VarChar(64)
  day         String    @db.VarChar(10)
  requests    Int       @default(0)
  ko          Int       @default(0)
  maxPerDay   Int?
  maxKoPerDay Int?
  maxPerMin   Int?
  pausedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

// Last version of a save synced with each device (basis for detecting conflicts)
model SaveDeviceState {
  saveId     Int
  deviceId   Int
  versionId  Int?
  // sha1 of the file as it ended up on the device (already converted)
  deviceSha1 String?  @db.Char(40)
  syncedAt   DateTime @default(now())
  save       Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([saveId, deviceId])
}

model SaveConflict {
  id              Int       @id @default(autoincrement())
  saveId          Int
  deviceId        Int
  deviceVersionId Int
  serverVersionId Int
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?
  // device | server
  resolution      String?   @db.VarChar(8)
  save            Save      @relation(fields: [saveId], references: [id], onDelete: Cascade)
  device          Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

// Fingerprint of the content of a rom we hold: crc32 of 1 KiB blocks (no header), sampled
// by content. Used to find the base rom of a romhack by similarity.
model RomSignature {
  romId     Int      @id
  fileSha1  String   @db.Char(40)
  chunks    Int
  sample    Bytes    @db.MediumBlob
  createdAt DateTime @default(now())
}

// Pairing of a sync client by short code (device authorization flow)
model DeviceLink {
  id           Int       @id @default(autoincrement())
  code         String    @unique @db.VarChar(16)
  secretHash   String    @unique @db.Char(64)
  deviceName   String    @db.VarChar(128)
  firmwareHint String?   @db.VarChar(64)
  rootHint     String?   @db.VarChar(512)
  model        String?   @db.VarChar(128)
  overrides    Json?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  approvedAt   DateTime?
  deliveredAt  DateTime?
  userId       Int?
  deviceId     Int?
  // Device token kept encrypted until the client collects it once
  tokenEnc     String?   @db.Text
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Lists whose roms a sync client keeps on its device
model DeviceList {
  deviceId Int
  listId   Int
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  list     List   @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([deviceId, listId])
}

// Roms found on a device at its last full sync (only the list, not the files)
model DeviceRom {
  id             Int     @id @default(autoincrement())
  deviceId       Int
  // sha1 of the path, for the unique key (paths are too long to index)
  pathHash       String  @db.Char(40)
  path           String  @db.VarChar(1024)
  systemSlug     String? @db.VarChar(32)
  size           BigInt  @default(0)
  sha1           String? @db.Char(40)
  headerlessSha1 String? @db.Char(40)
  romId          Int?
  gameId         Int?
  // Product code read from the file's header, and the game it belongs to when the file is a hack or translation of it
  serial         String? @db.VarChar(64)
  baseGameId     Int?
  device         Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, pathHash])
  @@index([gameId])
  @@index([romId])
}

// What the header of a device's file said, read once per path and size ("none" when it holds no code we know)
model DeviceProbe {
  id        Int      @id @default(autoincrement())
  deviceId  Int
  pathHash  String   @db.Char(40)
  size      BigInt   @default(0)
  // Platform the header belongs to (gba, psx, gc...) and its product code
  platform  String?  @db.VarChar(16)
  serial    String?  @db.VarChar(64)
  at        DateTime @default(now())
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, pathHash])
}

// A rom the server asked a device to send (pending | done | failed)
model DevicePull {
  id        Int       @id @default(autoincrement())
  deviceId  Int
  path      String    @db.VarChar(1024)
  status    String    @default("pending") @db.VarChar(16)
  result    String?   @db.VarChar(512)
  createdAt DateTime  @default(now())
  doneAt    DateTime?
  device    Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, status])
}

/**
 * A key for one SD card of a device, synced from a computer with the desktop companion
 */
model DeviceToken {
  id        Int      @id @default(autoincrement())
  deviceId  Int
  tokenHash String   @unique @db.Char(64)
  label     String   @db.VarChar(128)
  createdAt DateTime @default(now())
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
}

/// A network the user's consoles should know
model WifiNetwork {
  id        Int      @id @default(autoincrement())
  userId    Int
  ssid      String   @db.VarChar(64)
  // Encrypted; null = open network
  password  String?  @db.Text
  // 2.4 | 5 | dual (the same name on both bands)
  band      String   @default("dual") @db.VarChar(8)
  hidden    Boolean  @default(false)
  // Lower first
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A copy of a device's configuration files; contents live in DATA_DIR/device-config/blobs/<sha1>
model DeviceConfigVersion {
  id        Int      @id @default(autoincrement())
  deviceId  Int
  // backup (asked for) | before (taken before a change) | edit (made in the web app)
  source    String   @db.VarChar(16)
  note      String?  @db.VarChar(255)
  // [{ path, sha1, size }]; paths relative to the device root, or absolute outside it
  files     Json
  bytes     Int      @default(0)
  createdAt DateTime @default(now())
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, createdAt])
}

/// Work for a device's configuration: read its files (backup), apply the user's settings, or restore a version.
/// Carried out by whichever channel reaches the device first: its client, SSH or its card on a computer.
model DeviceConfigOp {
  id        Int       @id @default(autoincrement())
  deviceId  Int
  // backup | settings | restore
  kind      String    @db.VarChar(16)
  // pending | collecting | applying | done | failed
  status    String    @default("pending") @db.VarChar(16)
  // restore: { versionId, paths? }; while running: { collected, writes, settingsHash }
  payload   Json?
  channel   String?   @db.VarChar(8)
  error     String?   @db.VarChar(512)
  // The copy taken by this operation
  versionId Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  doneAt    DateTime?
  device    Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, status])
}

/// A rom the user marked as favourite (its game shows as favourite too)
model RomFavorite {
  userId    Int
  romId     Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rom       Rom      @relation(fields: [romId], references: [id], onDelete: Cascade)

  @@id([userId, romId])
  @@index([romId])
}

/// The user's achievements in a RetroAchievements game, read with their own Web API key
model RaUserProgress {
  userId          Int
  raGameId        Int
  awarded         Int       @default(0)
  awardedHardcore Int       @default(0)
  total           Int       @default(0)
  lastAt          DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, raGameId])
}
