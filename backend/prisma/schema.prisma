generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum DatType {
  USER
  NOINTRO
  REDUMP
  FBNEO
  MAME
  HACKS
  OTHER
}

enum MatchStatus {
  MATCHED
  HACK
  UNVERIFIED
  UNKNOWN
}

enum MediaType {
  COVER
  BOX_BACK
  BOX_SIDE
  BOX_3D
  SUPPORT
  SCREENSHOT
  TITLE
  FLYER
  FANART
  MANUAL
  VIDEO
  MARQUEE
  WHEEL
}

enum Visibility {
  PRIVATE
  SHARED
  PUBLIC
}

enum ConnType {
  LOCAL
  SSH
  // El dispositivo ejecuta scripts de eventos (ES-DE, EmulationStation) y habla con la API
  AGENT
}

enum SaveKind {
  SAVE
  STATE
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum HackType {
  HACK
  TRANSLATION
  IMPROVEMENT
  OTHER
}

model User {
  id                 Int      @id @default(autoincrement())
  username           String   @unique @db.VarChar(64)
  email              String   @unique @db.VarChar(191)
  passwordHash       String
  role               Role     @default(USER)
  locale             String   @default("es") @db.VarChar(8)
  // Credenciales externas cifradas (AES-256-GCM)
  ssUser             String?  @db.Text
  ssPassword         String?  @db.Text
  raUser             String?  @db.Text
  raApiKey           String?  @db.Text
  tgdbApiKey         String?  @db.Text
  // Lista de permisos (ver lib/permissions.ts). El admin los tiene todos.
  permissions        Json?
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())

  lists         List[]
  listShares    ListShare[]
  devices       Device[]
  deviceLinks   DeviceLink[]
  saves         Save[]
  jobs          Job[]
  refreshTokens RefreshToken[]
  invitations   Invitation[]   @relation("invitationCreator")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invitation {
  id          Int       @id @default(autoincrement())
  token       String    @unique @db.VarChar(64)
  role        Role      @default(USER)
  createdBy   Int
  usedById    Int?
  usedAt      DateTime?
  expiresAt   DateTime
  permissions Json?
  creator     User      @relation("invitationCreator", fields: [createdBy], references: [id], onDelete: Cascade)
}

model Setting {
  key   String @id @db.VarChar(64)
  value String @db.Text
}

model System {
  id           Int    @id @default(autoincrement())
  slug         String @unique @db.VarChar(32)
  name         String @db.VarChar(128)
  manufacturer String @db.VarChar(64)
  // Nombre usado por No-Intro/Redump/libretro, p.ej. "Nintendo - Nintendo Entertainment System"
  datName      String @unique @db.VarChar(191)
  datAliases   Json?
  extensions   Json
  // nes | snes | lynx | a7800 | fds | none
  headerType   String @default("none") @db.VarChar(16)
  // rom | disc | arcade
  mediaType    String @default("rom") @db.VarChar(16)
  raConsoleId  Int?
  ssSystemId   Int?
  sortOrder    Int    @default(0)

  games      Game[]
  datSources DatSource[]
  raGames    RaGame[]
}

model DatSource {
  id         Int       @id @default(autoincrement())
  type       DatType
  systemId   Int
  name       String    @db.VarChar(191)
  version    String?   @db.VarChar(64)
  fileSha1   String    @db.VarChar(40)
  // Nombre del fichero en DATA_DIR/dats o SEED_DIR/dats
  fileName   String?   @db.VarChar(255)
  // Mayor prioridad: fuente principal de los nombres y datos (No-Intro oficial sobre copias de libretro)
  priority   Int       @default(0)
  importedAt DateTime  @default(now())
  romCount   Int       @default(0)
  system     System    @relation(fields: [systemId], references: [id], onDelete: Cascade)
  roms       Rom[]
  hacks      RomHack[]

  @@unique([systemId, type, name])
}

model Game {
  id              Int        @id @default(autoincrement())
  systemId        Int
  title           String     @db.VarChar(255)
  titleNormalized String     @db.VarChar(255)
  releaseYear     Int?
  developer       String?    @db.VarChar(128)
  publisher       String?    @db.VarChar(128)
  genre           String?    @db.VarChar(128)
  players         String?    @db.VarChar(32)
  description     String?    @db.Text
  ssGameId        Int?
  tgdbGameId      Int?
  // Saga segun libretro (se usa si Wikidata no la da)
  franchiseName   String?    @db.VarChar(255)
  scrapedAt       DateTime?
  // Procedencia de cada campo: { campo: fuente }. Prioridad manual > screenscraper > thegamesdb > libretro
  metaSources     Json?
  // Agrupacion: obra multiplataforma, elemento de Wikidata y confianza de la agrupacion regional
  workId          Int?
  wikidataId      String?    @db.VarChar(16)
  groupConfidence String     @default("high") @db.VarChar(8)
  createdById     Int?
  system          System     @relation(fields: [systemId], references: [id], onDelete: Cascade)
  work            Work?      @relation(fields: [workId], references: [id], onDelete: SetNull)
  roms            Rom[]
  hacks           RomHack[]
  media           Media[]
  listItems       ListItem[]
  saves           Save[]

  @@index([systemId, titleNormalized])
  @@index([title])
  @@index([workId])
}

model Rom {
  id                Int        @id @default(autoincrement())
  gameId            Int
  datSourceId       Int
  name              String     @db.VarChar(255)
  regions           Json
  languages         Json
  revision          String?    @db.VarChar(32)
  flags             Json
  isBios            Boolean    @default(false)
  // Hash RA precalculado a partir del DAT cuando el algoritmo lo permite
  raHash            String?    @db.Char(32)
  raGameId          Int?
  serial            String?    @db.VarChar(64)
  // Titulo original (p.ej. japones) segun Retool
  localTitle        String?    @db.VarChar(255)
  // Descripcion del DAT (en arcade es el titulo; el nombre es el del set)
  description       String?    @db.VarChar(255)
  // Padre segun No-Intro Parent/Clone
  parentName        String?    @db.VarChar(255)
  // La fuente ya no la contiene; se conserva (datos permanentes)
  removedFromSource Boolean    @default(false)
  checkedAt         DateTime?
  createdById       Int?
  game              Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  datSource         DatSource  @relation(fields: [datSourceId], references: [id], onDelete: Cascade)
  parts             RomPart[]
  listItems         ListItem[]
  media             Media[]
  saves             Save[]
  baseOfHacks       RomHack[]

  @@unique([datSourceId, name])
  @@index([raHash])
  @@index([gameId])
}

model RomPart {
  id             Int       @id @default(autoincrement())
  romId          Int
  name           String    @db.VarChar(255)
  size           BigInt
  crc32          String?   @db.Char(8)
  md5            String?   @db.Char(32)
  sha1           String?   @db.Char(40)
  headerlessSize BigInt?
  headerlessCrc  String?   @db.Char(8)
  headerlessMd5  String?   @db.Char(32)
  headerlessSha1 String?   @db.Char(40)
  rom            Rom       @relation(fields: [romId], references: [id], onDelete: Cascade)
  files          RomFile[]

  @@index([sha1])
  @@index([md5])
  @@index([crc32, size])
  @@index([headerlessSha1])
  @@index([headerlessMd5])
  @@index([romId])
}

model RomHack {
  id                Int        @id @default(autoincrement())
  gameId            Int
  baseRomId         Int?
  datSourceId       Int?
  type              HackType   @default(HACK)
  title             String     @db.VarChar(255)
  // Nombre corto del hack ("Spec II"); version es la del hack, no la del juego
  hackName          String?    @db.VarChar(255)
  author            String?    @db.VarChar(255)
  version           String?    @db.VarChar(64)
  language          String?    @db.VarChar(32)
  description       String?    @db.Text
  sourceUrl         String?    @db.VarChar(512)
  size              BigInt?
  crc32             String?    @db.Char(8)
  md5               String?    @db.Char(32)
  sha1              String?    @db.Char(40)
  // Hash del contenido sin cabecera (NES, SNES...), para reconocer el fichero con o sin ella
  headerlessSha1    String?    @db.Char(40)
  // Como se enlazo con su rom base: dat | patch | content | header | manual | title
  baseEvidence      String?    @db.VarChar(16)
  removedFromSource Boolean    @default(false)
  createdAt         DateTime   @default(now())
  game              Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  baseRom           Rom?       @relation(fields: [baseRomId], references: [id], onDelete: SetNull)
  patches           RomPatch[]
  datSource         DatSource? @relation(fields: [datSourceId], references: [id], onDelete: Cascade)
  files             RomFile[]
  listItems         ListItem[]

  @@index([sha1])
  @@index([md5])
  @@index([headerlessSha1])
}

model RomPath {
  id              Int       @id @default(autoincrement())
  label           String    @db.VarChar(128)
  path            String    @unique @db.VarChar(700)
  // Si se fija, todo lo escaneado se asume de ese sistema; si no, se deduce por carpeta/extension
  systemId        Int?
  // Destino de roms nuevas (subidas, parches): sistemas (slugs) que recibe y esquema de carpetas
  targetSystems   Json?
  isDefaultTarget Boolean   @default(false)
  // system | flat | <slug de firmware>
  targetScheme    String    @default("system") @db.VarChar(32)
  readOnly        Boolean   @default(false)
  lastScanAt      DateTime?
  files           RomFile[]
}

model RomFile {
  id             Int         @id @default(autoincrement())
  romPathId      Int
  // sha1(relativePath + "\0" + archiveEntry) para indice unico
  pathKey        String      @db.Char(40)
  relativePath   String      @db.VarChar(1024)
  archiveEntry   String?     @db.VarChar(512)
  size           BigInt
  // Tamano y fecha del fichero en disco (deteccion de cambios; size es el del contenido)
  fileSize       BigInt      @default(0)
  // sha1(tamano + primer MiB + ultimo MiB): reutiliza hashes de ficheros movidos o renombrados
  quickHash      String?     @db.Char(40)
  mtimeMs        BigInt
  crc32          String      @db.Char(8)
  md5            String?     @db.Char(32)
  sha1           String?     @db.Char(40)
  headerlessCrc  String?     @db.Char(8)
  headerlessMd5  String?     @db.Char(32)
  headerlessSha1 String?     @db.Char(40)
  raHash         String?     @db.Char(32)
  systemId       Int?
  status         MatchStatus @default(UNKNOWN)
  romPartId      Int?
  romHackId      Int?
  uploadedById   Int?
  // Formato contenedor (rvz, wbfs, cso...) e id de disco si aplica
  container      String?     @db.VarChar(8)
  discId         String?     @db.VarChar(16)
  // Ya evaluado como posible romhack por contenido
  hackCheckedAt  DateTime?
  scannedAt      DateTime    @default(now())
  romPath        RomPath     @relation(fields: [romPathId], references: [id], onDelete: Cascade)
  romPart        RomPart?    @relation(fields: [romPartId], references: [id], onDelete: SetNull)
  romHack        RomHack?    @relation(fields: [romHackId], references: [id], onDelete: SetNull)

  @@unique([romPathId, pathKey])
  @@index([sha1])
  @@index([quickHash])
  @@index([romPartId])
  @@index([status])
}

model Media {
  id        Int       @id @default(autoincrement())
  gameId    Int?
  romId     Int?
  type      MediaType
  source    String    @db.VarChar(32)
  path      String    @db.VarChar(512)
  region    String?   @db.VarChar(16)
  language  String?   @db.VarChar(16)
  size      Int?
  createdAt DateTime  @default(now())
  game      Game?     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  rom       Rom?      @relation(fields: [romId], references: [id], onDelete: Cascade)

  @@index([gameId, type])
}

model List {
  id              Int         @id @default(autoincrement())
  ownerId         Int
  name            String      @db.VarChar(191)
  description     String?     @db.Text
  visibility      Visibility  @default(PRIVATE)
  isCollaborative Boolean     @default(false)
  parentListId    Int?
  derivedFilter   Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  owner           User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parent          List?       @relation("derived", fields: [parentListId], references: [id], onDelete: SetNull)
  children        List[]      @relation("derived")
  items           ListItem[]
  devices         DeviceList[]
  shares          ListShare[]
}

model ListItem {
  id       Int      @id @default(autoincrement())
  listId   Int
  gameId   Int?
  romId    Int?
  hackId   Int?
  workId   Int?
  // Clave unica: g<id> | r<id> | h<id> | w<id>
  itemKey  String   @db.VarChar(24)
  position Int      @default(0)
  note     String?  @db.VarChar(512)
  list     List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  game     Game?    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  rom      Rom?     @relation(fields: [romId], references: [id], onDelete: Cascade)
  hack     RomHack? @relation(fields: [hackId], references: [id], onDelete: Cascade)
  work     Work?    @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([listId, itemKey])
}

model ListShare {
  listId  Int
  userId  Int
  canEdit Boolean @default(false)
  list    List    @relation(fields: [listId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([listId, userId])
}

model Console {
  id           Int      @id @default(autoincrement())
  name         String   @unique @db.VarChar(128)
  manufacturer String   @db.VarChar(64)
  formFactor   String   @default("handheld") @db.VarChar(32)
  devices      Device[]
}

model Firmware {
  id          Int      @id @default(autoincrement())
  slug        String   @unique @db.VarChar(32)
  name        String   @db.VarChar(128)
  // Rutas relativas a la raiz del dispositivo
  romsRoot    String   @db.VarChar(255)
  savesRoot   String   @db.VarChar(255)
  statesRoot  String   @db.VarChar(255)
  biosRoot    String   @db.VarChar(255)
  // { systemSlug: { folder, emulator } }
  systemMap   Json
  // flat: savesRoot/<rom>.srm | system: savesRoot/<folder>/ | core: savesRoot/<core>/ | rom: junto a la rom
  savesLayout String   @default("flat") @db.VarChar(16)
  devices     Device[]
}

model Device {
  id             Int               @id @default(autoincrement())
  userId         Int
  name           String            @db.VarChar(128)
  consoleId      Int
  firmwareId     Int
  connType       ConnType
  // Raiz del dispositivo: path local (SD montada) o path remoto via SSH
  rootPath       String            @db.VarChar(512)
  sshHost        String?           @db.VarChar(255)
  sshPort        Int?              @default(22)
  sshUser        String?           @db.VarChar(64)
  // Cifrado
  sshPassword    String?           @db.Text
  sshKey         String?           @db.Text
  // Sobrescribe campos de Firmware: { romsRoot, savesRoot, statesRoot, systemMap }
  overrides      Json?
  syncSaves      Boolean           @default(false)
  lastSyncAt     DateTime?
  // Token para scripts del dispositivo (sha256); null = sin token
  tokenHash      String?           @unique @db.Char(64)
  tokenCreatedAt DateTime?
  lastSeenAt     DateTime?
  // Tail of the client's log and its version, sent after each sync (remote troubleshooting)
  lastLog        String?           @db.Text
  clientVersion  String?           @db.VarChar(32)
  romLists       DeviceList[]
  // The device lets the server fetch roms from it (client setting, reported on every sync)
  allowPull      Boolean           @default(true)
  // Set from the web app; the client syncs at its next poll and clears it
  wantSyncAt     DateTime?
  inventoryAt    DateTime?
  inventory      DeviceRom[]
  pulls          DevicePull[]
  createdAt      DateTime          @default(now())
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  console        Console           @relation(fields: [consoleId], references: [id])
  firmware       Firmware          @relation(fields: [firmwareId], references: [id])
  saveVersions   SaveVersion[]
  saveStates     SaveDeviceState[]
  conflicts      SaveConflict[]
}

model Emulator {
  id         Int     @id @default(autoincrement())
  slug       String  @unique @db.VarChar(64)
  name       String  @db.VarChar(128)
  // Core de RetroArch si aplica
  core       String? @db.VarChar(64)
  // Formato logico de save: raw | ps1card
  saveFormat String  @default("raw") @db.VarChar(16)
  saveExt    String  @db.VarChar(16)
  stateExt   String? @db.VarChar(16)
  saves      Save[]
}

model Save {
  id               Int               @id @default(autoincrement())
  userId           Int
  gameId           Int?
  romId            Int?
  emulatorId       Int
  kind             SaveKind
  slot             Int               @default(0)
  // Nombre base del fichero (sin extension) tal y como se encontro
  baseName         String            @db.VarChar(255)
  currentVersionId Int?
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  game             Game?             @relation(fields: [gameId], references: [id], onDelete: SetNull)
  rom              Rom?              @relation(fields: [romId], references: [id], onDelete: SetNull)
  emulator         Emulator          @relation(fields: [emulatorId], references: [id])
  versions         SaveVersion[]
  deviceStates     SaveDeviceState[]
  conflicts        SaveConflict[]

  @@unique([userId, emulatorId, kind, slot, baseName])
}

model SaveVersion {
  id             Int      @id @default(autoincrement())
  saveId         Int
  path           String   @db.VarChar(512)
  size           Int
  sha1           String   @db.Char(40)
  // mtime del fichero en origen
  fileMtime      DateTime
  sourceDeviceId Int?
  note           String?  @db.VarChar(255)
  createdAt      DateTime @default(now())
  save           Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  sourceDevice   Device?  @relation(fields: [sourceDeviceId], references: [id], onDelete: SetNull)

  @@index([saveId])
}

model RaGame {
  id              Int      @id
  systemId        Int
  title           String   @db.VarChar(255)
  numAchievements Int      @default(0)
  imageIcon       String?  @db.VarChar(255)
  fetchedAt       DateTime @default(now())
  system          System   @relation(fields: [systemId], references: [id], onDelete: Cascade)
  hashes          RaHash[]
}

model RaHash {
  hash     String @db.Char(32)
  raGameId Int
  raGame   RaGame @relation(fields: [raGameId], references: [id], onDelete: Cascade)

  @@id([hash, raGameId])
  @@index([raGameId])
}

model Job {
  id         Int       @id @default(autoincrement())
  userId     Int?
  type       String    @db.VarChar(32)
  status     JobStatus @default(PENDING)
  params     Json
  total      Int       @default(0)
  processed  Int       @default(0)
  message    String?   @db.VarChar(512)
  log        String?   @db.MediumText
  result     Json?
  // No ejecutar antes de esta fecha (reanudaciones por cuota)
  runAfter   DateTime?
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
}

model Work {
  id          Int        @id @default(autoincrement())
  title       String     @db.VarChar(255)
  wikidataId  String?    @unique @db.VarChar(16)
  franchiseId Int?
  releaseYear Int?
  franchise   Franchise? @relation(fields: [franchiseId], references: [id], onDelete: SetNull)
  games       Game[]
  listItems   ListItem[]
}

model Franchise {
  id         Int     @id @default(autoincrement())
  name       String  @db.VarChar(255)
  wikidataId String? @unique @db.VarChar(16)
  works      Work[]
}

// Evidencia de agrupacion: roms (o juegos) con la misma clave pertenecen al mismo grupo
model GroupingEvidence {
  id         Int      @id @default(autoincrement())
  // rom-game: agrupa roms en juegos; game-work: enlaza juegos con elementos de Wikidata
  kind       String   @db.VarChar(12)
  romId      Int?
  gameId     Int?
  systemId   Int
  key        String   @db.VarChar(255)
  // manual | nointro-pc | retool | ra | screenscraper | wikidata | title
  source     String   @db.VarChar(16)
  confidence Int
  createdAt  DateTime @default(now())

  @@unique([kind, romId, gameId, source, key])
  @@index([kind, systemId, key])
  @@index([romId])
  @@index([gameId])
}

// Decisiones manuales que el resolvedor respeta
model GroupingRule {
  id         Int      @id @default(autoincrement())
  kind       String   @db.VarChar(12)
  // same | different
  rule       String   @db.VarChar(10)
  aRomId     Int?
  bRomId     Int?
  aGameId    Int?
  bGameId    Int?
  wikidataId String?  @db.VarChar(16)
  userId     Int?
  createdAt  DateTime @default(now())
}

model ReviewItem {
  id         Int       @id @default(autoincrement())
  // title-group | conflict | wikidata
  kind       String    @db.VarChar(16)
  systemId   Int?
  gameId     Int?
  key        String    @db.VarChar(191)
  payload    Json
  status     String    @default("open") @db.VarChar(10)
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  resolvedBy Int?

  @@unique([kind, key])
  @@index([status, kind])
}

// Subconjunto local de Wikidata: videojuegos de las plataformas soportadas
model WikidataItem {
  qid          String    @id @db.VarChar(16)
  label        String    @db.VarChar(255)
  names        Json
  platforms    Json
  year         Int?
  seriesQid    String?   @db.VarChar(16)
  franchiseQid String?   @db.VarChar(16)
  raIds        Json?
  ssIds        Json?
  modified     DateTime?
  fetchedAt    DateTime  @default(now())
}

model WikidataLabel {
  qid   String @id @db.VarChar(16)
  label String @db.VarChar(255)
}

model RomPatch {
  id          Int      @id @default(autoincrement())
  hackId      Int
  format      String   @db.VarChar(4)
  // Ruta relativa en DATA_DIR/patches
  path        String   @db.VarChar(255)
  size        Int
  sha1        String   @unique @db.Char(40)
  baseRomId   Int?
  baseCrc32   String?  @db.Char(8)
  targetCrc32 String?  @db.Char(8)
  sourceUrl   String?  @db.VarChar(512)
  createdById Int?
  createdAt   DateTime @default(now())
  hack        RomHack  @relation(fields: [hackId], references: [id], onDelete: Cascade)
}

// Estado conocido de cada fuente externa (ETag, version, fechas)
model SourceState {
  key          String    @id @db.VarChar(191)
  etag         String?   @db.VarChar(255)
  lastModified String?   @db.VarChar(64)
  version      String?   @db.VarChar(64)
  checkedAt    DateTime?
  changedAt    DateTime?
}

// "No encontrado" en un servicio externo, para no repetir la consulta en meses
model ScrapeMiss {
  id     Int      @id @default(autoincrement())
  gameId Int
  source String   @db.VarChar(16)
  at     DateTime @default(now())

  @@unique([gameId, source])
}

// Cuota diaria por credencial de ScreenScraper/TheGamesDB
model ScrapeQuota {
  key         String    @id @db.VarChar(64)
  day         String    @db.VarChar(10)
  requests    Int       @default(0)
  ko          Int       @default(0)
  maxPerDay   Int?
  maxKoPerDay Int?
  maxPerMin   Int?
  pausedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

// Ultima version de un save sincronizada con cada dispositivo (base para detectar conflictos)
model SaveDeviceState {
  saveId     Int
  deviceId   Int
  versionId  Int?
  // sha1 del fichero tal como quedo en el dispositivo (ya convertido)
  deviceSha1 String?  @db.Char(40)
  syncedAt   DateTime @default(now())
  save       Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([saveId, deviceId])
}

model SaveConflict {
  id              Int       @id @default(autoincrement())
  saveId          Int
  deviceId        Int
  deviceVersionId Int
  serverVersionId Int
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?
  // device | server
  resolution      String?   @db.VarChar(8)
  save            Save      @relation(fields: [saveId], references: [id], onDelete: Cascade)
  device          Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

// Huella del contenido de una rom que se tiene: crc32 de bloques de 1 KiB (sin cabecera), muestreados
// por contenido. Sirve para encontrar la rom base de un romhack por parecido.
model RomSignature {
  romId     Int      @id
  fileSha1  String   @db.Char(40)
  chunks    Int
  sample    Bytes    @db.MediumBlob
  createdAt DateTime @default(now())
}

// Pairing of a sync client by short code (device authorization flow)
model DeviceLink {
  id           Int       @id @default(autoincrement())
  code         String    @unique @db.VarChar(16)
  secretHash   String    @unique @db.Char(64)
  deviceName   String    @db.VarChar(128)
  firmwareHint String?   @db.VarChar(64)
  rootHint     String?   @db.VarChar(512)
  model        String?   @db.VarChar(128)
  overrides    Json?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  approvedAt   DateTime?
  deliveredAt  DateTime?
  userId       Int?
  deviceId     Int?
  // Device token kept encrypted until the client collects it once
  tokenEnc     String?   @db.Text
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Lists whose roms a sync client keeps on its device
model DeviceList {
  deviceId Int
  listId   Int
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  list     List   @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([deviceId, listId])
}

// Roms found on a device at its last full sync (only the list, not the files)
model DeviceRom {
  id             Int      @id @default(autoincrement())
  deviceId       Int
  // sha1 of the path, for the unique key (paths are too long to index)
  pathHash       String   @db.Char(40)
  path           String   @db.VarChar(1024)
  systemSlug     String?  @db.VarChar(32)
  size           BigInt   @default(0)
  sha1           String?  @db.Char(40)
  headerlessSha1 String?  @db.Char(40)
  romId          Int?
  gameId         Int?
  device         Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, pathHash])
  @@index([gameId])
  @@index([romId])
}

// A rom the server asked a device to send (pending | done | failed)
model DevicePull {
  id        Int       @id @default(autoincrement())
  deviceId  Int
  path      String    @db.VarChar(1024)
  status    String    @default("pending") @db.VarChar(16)
  result    String?   @db.VarChar(512)
  createdAt DateTime  @default(now())
  doneAt    DateTime?
  device    Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, status])
}
