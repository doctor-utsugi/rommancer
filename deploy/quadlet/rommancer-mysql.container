[Unit]
Description=Rommancer MySQL

[Container]
ContainerName=rommancer-mysql
# MySQL with passwords of its own, generated on the first start into the API's data/secrets (deploy/mysql)
Image=localhost/rommancer-mysql:latest
Network=rommancer.network
NetworkAlias=mysql
Volume=rommancer-mysql.volume:/var/lib/mysql
Volume=%h/rommancer/data/secrets:/secrets:z
HealthCmd=mysqladmin ping -h 127.0.0.1 --silent
HealthInterval=10s

[Service]
Restart=always
ExecStartPre=/bin/mkdir -p %h/rommancer/data/secrets

[Install]
WantedBy=default.target
