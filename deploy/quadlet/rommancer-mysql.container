[Unit]
Description=Rommancer MySQL

[Container]
ContainerName=rommancer-mysql
Image=docker.io/library/mysql:8.4
Network=rommancer.network
NetworkAlias=mysql
Volume=rommancer-mysql.volume:/var/lib/mysql
EnvironmentFile=%h/.config/rommancer/rommancer.env
Exec=--character-set-server=utf8mb4 --collation-server=utf8mb4_0900_ai_ci
HealthCmd=mysqladmin ping -h 127.0.0.1
HealthInterval=10s

[Service]
Restart=always

[Install]
WantedBy=default.target
