[Unit]
Description=Rommancer API
Requires=rommancer-mysql.service
After=rommancer-mysql.service

[Container]
ContainerName=rommancer-api
Image=localhost/rommancer-api:latest
Network=rommancer.network
NetworkAlias=api
Environment=DATA_DIR=/data
# The installer offers this database as the recommended one
Environment=ROMMANCER_BUNDLED_DB=mysql:3306
Environment=SEED_DIR=/seed
# App data (media, saves, uploads, dats)
Volume=%h/rommancer/data:/data:z
# Seed (copy the repository's seed/ folder here)
Volume=%h/rommancer/seed:/seed:Z
# Rom folders: registered in the app as /roms/...
Volume=%h/roms:/roms:z

[Service]
Restart=always
# MySQL takes a few seconds to accept connections on first start
RestartSec=5

[Install]
WantedBy=default.target
